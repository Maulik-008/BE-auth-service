{
    "name": "auth-service",
    "version": "1.0.0",
    "main": "index.js",
    "scripts": {
        "build": "tsc",
        "start": "cross-env NODE_ENV=prod ts-node src/index.ts",
        "dev": "cross-env NODE_ENV=dev nodemon --exec ts-node src/server.ts",
        "db:start": " sudo docker run --rm --name mernpg-container -e POSTGRES_USER=root -e POSTGRES_PASSWORD=root -v mern-postgres:/var/lib/postgresql/data -p 5434:5432 -d postgres",
        "db:stop": "sudo docker stop mernpg-container",
        "migration:revert": "typeorm-ts-node-commonjs migration:revert",
        "migration:generate": "typeorm-ts-node-commonjs migration:generate",
        "migration:run": "typeorm-ts-node-commonjs migration:run",
        "migration:create": "typeorm-ts-node-commonjs migration:create"
    },
    "author": "Maulik Joshi",
    "license": "ISC",
    "description": "",
    "devDependencies": {
        "@types/bcrypt": "^5.0.2",
        "@types/cookie-parser": "^1.4.9",
        "@types/express": "^5.0.1",
        "@types/http-errors": "^2.0.4",
        "@types/jsonwebtoken": "^9.0.9",
        "@types/node": "^22.15.17",
        "cross-env": "^7.0.3",
        "nodemon": "^3.1.10",
        "prettier": "3.5.3",
        "ts-node": "^10.9.2",
        "typescript": "^5.8.3"
    },
    "dependencies": {
        "@types/bcryptjs": "^2.4.6",
        "bcryptjs": "^3.0.2",
        "cookie-parser": "^1.4.7",
        "dotenv": "^16.5.0",
        "express": "^5.1.0",
        "express-jwt": "^8.5.1",
        "express-validator": "^7.2.1",
        "http-errors": "^2.0.0",
        "i": "^0.3.7",
        "jsonwebtoken": "^9.0.2",
        "jwks-rsa": "^3.2.0",
        "npm": "^11.4.2",
        "pg": "^8.14.1",
        "reflect-metadata": "^0.2.2",
        "rsa-pem-to-jwk": "^1.1.3",
        "typeorm": "0.3.23",
        "winston": "^3.17.0"
    }
}
